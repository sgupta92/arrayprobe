*.2ds
*.HVPS
*.hvps
*.cdf
*.nc
*.zip
*withShatters.mat
*noShatters.mat
diode.*.mat
_decoded/
**/images/
run_logs/
*.launch.log
examples/start_here/output/
paper/*.pdf
paper/figures/*.pdf
paper/figures/*.png

# The test fixtures the suite reads stay tracked
!tests/data/**/*.cdf
!tests/data/**/*.nc
!tests/data/**/*.2DS
